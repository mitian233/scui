{
  "name": "@mitian233/scui",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue component library built with Reka UI",
  "repository": { "type": "git", "url": "git+https://github.com/mitian233/scui.git" },
  "publishConfig": { "access": "public" },
  "files": [
    "dist/*.d.ts",
    "dist/components/*.d.ts",
    "dist/composables/*.d.ts",
    "dist/scui.js",
    "dist/scui.css",
    "README.md"
  ],
  "main": "./dist/scui.js",
  "module": "./dist/scui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/scui.js" },
    "./style.css": "./dist/scui.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "prepack": "npm run typecheck && vite build --config vite.lib.config.ts",
    "build": "npm run typecheck && vite build && vite build --config vite.lib.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "peerDependencies": { "vue": "^3.5.0", "reka-ui": "^2.0.0" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vue-tsc": "^3.0.0",
    "vue": "^3.5.0",
    "reka-ui": "^2.0.0"
  }
}
