{
  "name": "shiny-colors-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue components inspired by THE IDOLM@STER Shiny Colors, built with Reka UI",
  "files": ["dist", "README.md", "research/assets-manifest.json"],
  "main": "./dist/shiny-colors-ui.js",
  "module": "./dist/shiny-colors-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/shiny-colors-ui.js" },
    "./style.css": "./dist/shiny-colors-ui.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --config vite.lib.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "peerDependencies": { "vue": "^3.5.0", "reka-ui": "^2.0.0" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vue-tsc": "^3.0.0",
    "vue": "^3.5.0",
    "reka-ui": "^2.0.0"
  }
}
